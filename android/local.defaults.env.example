# Optional non-secret build defaults. API keys must be entered in the app at runtime.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
MEETINGNOTES_STT_ENDPOINT=http://localhost:8888
MEETINGNOTES_STT_MODEL=small
MEETINGNOTES_STT_CLOUD_ENDPOINT=
MEETINGNOTES_STT_CLOUD_MODEL=whisper-1
# Shared server model switching is an administrator-only operation.
MEETINGNOTES_STT_REMOTE_SWITCH_ENABLED=false
MEETINGNOTES_STT_SWITCH_TIMEOUT_SECONDS=90
MEETINGNOTES_STT_STREAM_SWITCH_TIMEOUT_SECONDS=20
# Limits Compose recomposition frequency without dropping the latest transcript.
MEETINGNOTES_STT_STREAM_UI_UPDATE_INTERVAL_MS=180
# The live card renders a tail window; the full transcript remains available on demand.
MEETINGNOTES_TRANSCRIPT_PREVIEW_MAX_CHARS=2400
MEETINGNOTES_STT_CLOUD_CONNECT_TIMEOUT_SECONDS=30
MEETINGNOTES_STT_CLOUD_READ_TIMEOUT_SECONDS=14400
MEETINGNOTES_STT_CLOUD_WRITE_TIMEOUT_SECONDS=3600
MEETINGNOTES_AGENT_ENDPOINT=https://your-server.example/api/agent
MEETINGNOTES_ACCOUNT_ENDPOINT=https://your-server.example/api
MEETINGNOTES_APP_UPDATE_ENDPOINT=https://your-server.example/api/app-update/android
# The Android Agent endpoint must remain the MeetingNotes gateway above. Codex relay
# BaseURL/API keys belong to the server-side Codex configuration and must not enter an APK.
# This optional file only supplies a non-secret direct-cloud BaseURL for local development.
MEETINGNOTES_RELAY_CONFIG_FILE=
MEETINGNOTES_RELAY_BASE_URL=
MEETINGNOTES_PROFILE_NAME_MAX_LENGTH=40
MEETINGNOTES_PROFILE_AVATAR_MAX_DIMENSION=512
MEETINGNOTES_PROFILE_AVATAR_JPEG_QUALITY=86
MEETINGNOTES_PROFILE_AVATAR_MAX_BYTES=262144

# Create android/local.defaults.env for a local build and set these values to
# the target environment. Never put STT/LLM/API credentials in this file.
