# Native Ubuntu production profile for 4 CPU cores / 4 GB RAM / no GPU.
STT_BIND_IP=0.0.0.0
STT_PORT=8888
STT_ENGINE=faster-whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MODEL_ROOT=/var/lib/meetingnotes-stt/models
STT_MODEL_SHA256=3e305921506d8872816023e4c273e75d2419fb89b24da97b4fe7bce14170d671
STT_STREAM_MODEL=small
STT_STREAM_MODEL_SHA256=3e305921506d8872816023e4c273e75d2419fb89b24da97b4fe7bce14170d671
STT_STREAM_CPU_THREADS=2
STT_FINAL_RETRY_MIN_CHARS=8
STT_FINAL_BEAM_SIZE=5
STT_FINAL_BATCH_SIZE=1
STT_FINAL_CONDITION_ON_PREVIOUS_TEXT=1
# Optional vocabulary/context hint. Keep blank unless meeting-specific terms are needed.
STT_FINAL_INITIAL_PROMPT=
# Final-file enhancement is adaptive: clean recordings bypass denoising.
STT_FINAL_AUDIO_ENHANCEMENT=1
STT_FINAL_DENOISE_NOISE_FLOOR_DBFS=-48
STT_FINAL_DENOISE_MAX_SNR_DB=26
STT_FINAL_GAIN_SPEECH_LEVEL_DBFS=-28
STT_FINAL_DENOISE_REDUCTION_DB=8
STT_FINAL_AUDIO_ANALYSIS_MAX_WINDOWS=3000
STT_FINAL_CONTEXT_HINT_MAX_CHARS=240
STT_FINAL_RESTORE_PUNCTUATION=1
STT_FINAL_PUNCTUATION_PAUSE_SEC=0.8
STT_STREAM_FINALIZE_WAIT_SEC=15

# Local final transcripts can attribute turns as 说话人 1/2/... when these
# sherpa-onnx models are present below STT_MODEL_ROOT. Tencent receives the
# same request flag when local inference falls back.
STT_SPEAKER_DIARIZATION_ENABLED=1
STT_SPEAKER_DIARIZATION_MAX_SPEAKERS=8
STT_SPEAKER_DIARIZATION_MIN_TURN_SEC=0.7
STT_SPEAKER_DIARIZATION_CLUSTER_THRESHOLD=0.9

STT_MAX_CONCURRENT=2
STT_CPU_THREADS=2
STT_MAX_QUEUE=16
STT_MAX_STREAMS=12
STT_MAX_STREAMS_PER_OWNER=2
STT_MAX_UPLOAD_MB=1024
# Long recordings are decoded in ordered local/cloud chunks and merged at boundaries.
STT_LONG_AUDIO_CHUNK_THRESHOLD_SEC=2700
STT_LONG_AUDIO_CHUNK_SECONDS=1800
STT_LONG_AUDIO_CHUNK_OVERLAP_SEC=3
STT_SWITCH_DRAIN_TIMEOUT_SEC=900

# Revisable preview profile. Final transcription remains small + beam 5;
# uninterrupted streams are finalized in place. Batch decoding is opt-in because
# it trades recognition quality for speed on the validated CPU profile.
STREAM_UPDATE_INTERVAL_SEC=0.4
STREAM_MIN_AUDIO_SEC=2
STREAM_MAX_SNAPSHOT_SEC=8
STREAM_BUFFER_SEC=24
STREAM_OVERLAP_SEC=4
STREAM_STEP_SEC=4
STREAM_BEAM_SIZE=1
STREAM_FINAL_COMPAT_MIN_AUDIO_SEC=2
STREAM_STABLE_SIMILARITY=0.70
STREAM_STABLE_MIN_CHARS=4
STREAM_PROVISIONAL_MIN_CHARS=2
STREAM_MIN_CONFIDENCE=-0.90
STREAM_MAX_NO_SPEECH_PROB=0.35
STREAM_REJECT_FALLBACK_THRESHOLD=3

STT_TEMP_DIR=/var/lib/meetingnotes-stt/tmp
STT_TEMP_MAX_AGE_SEC=21600
STT_TEMP_CLEANUP_INTERVAL_SEC=3600
STT_LOG_PATH=/var/lib/meetingnotes-stt/logs/stt.log
STT_AUDIO_ARCHIVE_ENABLED=1
STT_AUDIO_ARCHIVE_DIR=/var/lib/meetingnotes-stt/audio-archive
STT_AUDIO_ARCHIVE_RETENTION_DAYS=30
STT_AUDIO_ARCHIVE_MAX_GB=10

# Tencent Cloud credentials stay on the server. The old generic switches are
# deprecated and deliberately disabled; use the explicit tiers below.
TENCENT_ASR_ENABLED=0
TENCENT_ASR_BASE_URL=https://asr.cloud.tencent.com/asr/flash/v1
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_ASR_TIMEOUT_SEC=900
TENCENT_ASR_MAX_UPLOAD_MB=100
TENCENT_ASR_MAX_CONCURRENT=2
# Files above Tencent's per-request limit are normalized and sent as ordered cloud chunks.
TENCENT_ASR_CHUNK_SECONDS=2400
TENCENT_ASR_CHUNK_OVERLAP_SEC=3
TENCENT_REALTIME_ASR_ENABLED=0
TENCENT_REALTIME_ASR_BASE_URL=wss://asr.cloud.tencent.com/asr/v2
TENCENT_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_REALTIME_ASR_MAX_CONCURRENT=16
TENCENT_REALTIME_ASR_CONNECT_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_ACQUIRE_TIMEOUT_SEC=10
TENCENT_REALTIME_ASR_FINAL_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_SIGNATURE_TTL_SEC=3600
TENCENT_REALTIME_ASR_FRAME_MS=200
TENCENT_REALTIME_ASR_QUEUE_SEC=6
TENCENT_REALTIME_ASR_BACKPRESSURE_TIMEOUT_SEC=15
# Standard tier: Tencent's standard 16 kHz Chinese engines. The monthly value
# is exposed as a usage reference only; this tier has no application-side cap.
TENCENT_STANDARD_ASR_ENABLED=0
TENCENT_STANDARD_REALTIME_ASR_ENABLED=0
TENCENT_STANDARD_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_MONTHLY_LIMIT_SEC=18000
TENCENT_LEGACY_USAGE_TIER=precision
# Precision tier: Tencent large-model engines. Both enablement and a positive cap
# are mandatory; its recording-file requests remain protected by this cap.
TENCENT_PRECISION_ASR_ENABLED=0
TENCENT_PRECISION_REALTIME_ASR_ENABLED=0
TENCENT_PRECISION_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_MONTHLY_LIMIT_SEC=0
TENCENT_ASR_USAGE_ENABLED=1
TENCENT_ASR_USAGE_API_ENDPOINT=asr.tencentcloudapi.com
TENCENT_ASR_USAGE_REGION=ap-guangzhou
TENCENT_ASR_USAGE_TIMEZONE=Asia/Shanghai
TENCENT_ASR_USAGE_CACHE_SEC=300
TENCENT_ASR_USAGE_LEDGER_ENABLED=1
TENCENT_ASR_USAGE_LEDGER_PATH=/var/lib/meetingnotes-stt/data/tencent-asr-usage.db

STT_REQUIRE_API_TOKEN=1
# Static server management token. Keep it on the server only; account STT tokens
# are accepted for transcription but deliberately rejected by /admin/stt/switch.
STT_API_TOKEN=
WEB_API_TOKEN=
WEB_API_USERNAME=admin
COMMUNITY_WRITE_ENABLED=true
WEB_BACKEND_DB_PATH=/var/lib/meetingnotes-stt/backend/meeting_notes.db
ACCOUNT_DB_PATH=/var/lib/meetingnotes-stt/backend/accounts.db
ACCOUNT_MEDIA_DIR=/var/lib/meetingnotes-stt/backend/account-media
ACCOUNT_MEDIA_MAX_BYTES=12582912
# Production keeps this enabled. Set to 0 only on a personal GPU node whose
# signed account tokens and billing source of truth are managed upstream.
ACCOUNT_STT_BILLING_ENABLED=1

# Private Agent gateway. AGENT_API_TOKEN is generated during installation.
AGENT_ENABLED=1
AGENT_API_TOKEN=
AGENT_DEFAULT_REQUEST_LIMIT=1000
AGENT_ALLOWED_PROVIDERS=codex-cli,claude-cli
AGENT_MAX_CONCURRENT=1
AGENT_MAX_QUEUE=8
AGENT_TIMEOUT_SEC=600
# 0 removes the application-level image-count cap; per-file and total upload byte limits remain.
AGENT_MAX_IMAGES=0
AGENT_MAX_IMAGE_MB=12
AGENT_MAX_TOTAL_UPLOAD_MB=32
# 0 removes the application-level text/request JSON cap.
AGENT_MAX_TEXT_CHARS=0
AGENT_MAX_REQUEST_JSON_BYTES=0
AGENT_WORK_ROOT=/var/lib/meetingnotes-stt/agent-tasks
AGENT_CODEX_PATH=/usr/bin/codex
AGENT_CLAUDE_PATH=/usr/bin/claude
AGENT_CODEX_MODEL=
AGENT_CLAUDE_MODEL=
AGENT_CODEX_REASONING_EFFORT=medium
AGENT_CLAUDE_EFFORT=medium
# For relay/custom providers, set these to the environment variable names that
# hold each CLI credential. Leave blank when the CLI uses its own login store.
AGENT_CODEX_AUTH_ENV=
AGENT_CLAUDE_AUTH_ENV=

# Database-backed Android accounts. Secrets are generated/provided at deploy time.
ACCOUNT_TOKEN_SECRET=
ACCOUNT_ADMIN_USERNAME=admin
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_ADMIN_REQUEST_LIMIT=10000000
ACCOUNT_SESSION_TTL_SEC=2592000
ACCOUNT_FREE_REQUEST_LIMIT=10
ACCOUNT_FREE_PLAN_CODE=free
ACCOUNT_FREE_PLAN_NAME=免费账户
# Deprecated compatibility balances. Point billing is authoritative.
ACCOUNT_FREE_STT_MINUTES=0
ACCOUNT_FREE_AI_CREDITS=0
ACCOUNT_FREE_POINTS=1000
ACCOUNT_STT_POINTS_PER_MINUTE=10
ACCOUNT_AI_SUMMARY_POINTS=30
ACCOUNT_AI_CHAT_POINTS=10
ACCOUNT_STT_TOKEN_TTL_SEC=43200
ACCOUNT_PROFILE_NAME_MAX_LENGTH=40
ACCOUNT_PROFILE_AVATAR_MAX_BYTES=262144
ACCOUNT_PROFILE_AVATAR_DATA_URL_MAX_LENGTH=524288
ACCOUNT_AUTH_CODE_DEBUG=false
ACCOUNT_AUTH_CODE_WEBHOOK_URL=
ACCOUNT_AUTH_CODE_WEBHOOK_TOKEN=
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=465
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_FROM=
ACCOUNT_SMTP_USE_SSL=true
# Optional override; defaults to the release's config/account-plans.json.
ACCOUNT_PLANS_PATH=

HF_ENDPOINT=https://hf-mirror.com
WEB_BACKEND_HOST=127.0.0.1
WEB_BACKEND_PORT=8090
PUBLIC_STT_URL=
# Android app updates use non-secret metadata and APK files stored outside releases.
# The installer sets these state paths if they are not already configured.
APP_UPDATE_CONFIG_PATH=
APP_UPDATE_ANDROID_APK_PATH=
APP_UPDATE_LIGHT_CONFIG_PATH=
APP_UPDATE_LIGHT_ANDROID_APK_PATH=
