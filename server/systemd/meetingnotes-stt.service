[Unit]
Description=MeetingNotesApp STT Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meetingnotes
Group=meetingnotes
WorkingDirectory=/opt/meetingnotes-stt/current/stt-service
EnvironmentFile=/etc/meetingnotes-stt/stt.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/meetingnotes-stt/current-venv/bin/python -u stt_server.py
StandardOutput=append:/var/lib/meetingnotes-stt/logs/stt.log
StandardError=append:/var/lib/meetingnotes-stt/logs/stt.log
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15min
TimeoutStopSec=2min
KillSignal=SIGINT
UMask=0027

MemoryHigh=2700M
MemoryMax=3000M
CPUQuota=350%
TasksMax=128
LimitNOFILE=8192

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/meetingnotes-stt

[Install]
WantedBy=multi-user.target
