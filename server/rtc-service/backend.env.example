# Account backend environment; replace privately, never commit the real values.
MEETINGNOTES_RTC_URL=wss://rtc.example.com
MEETINGNOTES_RTC_API_URL=http://127.0.0.1:7880
MEETINGNOTES_RTC_API_KEY=
MEETINGNOTES_RTC_API_SECRET=

# Optional shared room transcription; disabled until RTC + V100 are deployed.
MEETINGNOTES_ROOM_TRANSCRIPTION_ENABLED=0
MEETINGNOTES_ROOM_STT_URL=wss://stt.example.com/ws/transcribe-stream
# Prefer the backend's existing ACCOUNT_TOKEN_SECRET, also configured on V100.
# Static service token is an alternative for isolated development deployments.
MEETINGNOTES_ROOM_STT_TOKEN=
MEETINGNOTES_ROOM_REPORT_PROVIDER=codex-cli
