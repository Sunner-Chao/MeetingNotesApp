# Network exposure. Keep the debug backend on localhost unless it is behind HTTPS/authentication.
STT_BIND_IP=0.0.0.0
STT_PORT=8888
BACKEND_BIND_IP=127.0.0.1
WEB_BACKEND_PORT=8090
# Optional public HTTPS URL shown in the debug console.
PUBLIC_STT_URL=

# Local Windows configuration. Ubuntu uses config/stt.env.example and generates tokens during installation.
STT_API_TOKEN=
WEB_API_TOKEN=
WEB_API_USERNAME=admin

# faster-whisper supports true parallel requests. SenseVoice uses one shared serialized model.
STT_ENGINE=faster-whisper
STT_MODEL=small
STT_STREAM_MODEL=small
STT_DEVICE=auto
STT_MAX_CONCURRENT=2
STT_MAX_QUEUE=16
STT_MAX_STREAMS=16
STT_MAX_UPLOAD_MB=256
STT_CPU_THREADS=2
STT_STREAM_CPU_THREADS=2
STT_FINAL_RETRY_MIN_CHARS=8

# Revisable preview; the completed file still uses the final small/beam-5 decoder.
STREAM_UPDATE_INTERVAL_SEC=0.4
STREAM_MIN_AUDIO_SEC=2
STREAM_MAX_SNAPSHOT_SEC=8
STREAM_BUFFER_SEC=24
STREAM_OVERLAP_SEC=4
STREAM_STEP_SEC=4
STREAM_BEAM_SIZE=1
STREAM_FINAL_COMPAT_MIN_AUDIO_SEC=2
STREAM_STABLE_SIMILARITY=0.70
STREAM_STABLE_MIN_CHARS=4
STREAM_PROVISIONAL_MIN_CHARS=2
STREAM_MIN_CONFIDENCE=-0.90
STREAM_MAX_NO_SPEECH_PROB=0.35
STREAM_REJECT_FALLBACK_THRESHOLD=3

# Set to 1 only when the larger SenseVoice/PyTorch dependency set is needed.
INSTALL_SENSEVOICE=0
STT_GPU_COUNT=1
HF_ENDPOINT=https://hf-mirror.com
