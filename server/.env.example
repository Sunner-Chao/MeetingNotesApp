# Network exposure. Keep the debug backend on localhost unless it is behind HTTPS/authentication.
STT_BIND_IP=0.0.0.0
STT_PORT=8888
BACKEND_BIND_IP=127.0.0.1
WEB_BACKEND_PORT=8090
# Built PWA directory. Defaults to a discovered release pwa-dist or source pwa/dist.
PWA_DIST_DIR=
# Optional public HTTPS URL shown in the debug console.
PUBLIC_STT_URL=

# Local Windows configuration. Ubuntu uses config/stt.env.example and generates tokens during installation.
# This is the server management token. Android account tokens may transcribe only;
# they cannot switch the shared STT model.
STT_API_TOKEN=
STT_PROXY_CONNECT_TIMEOUT_SEC=15
STT_PROXY_READ_TIMEOUT_SEC=1800
STT_AUDIO_ARCHIVE_ENABLED=0
STT_AUDIO_ARCHIVE_DIR=./data/audio-archive
STT_AUDIO_ARCHIVE_RETENTION_DAYS=30
STT_AUDIO_ARCHIVE_MAX_GB=10
# Deprecated generic Tencent switches. Keep disabled: tiered switches below are authoritative.
TENCENT_ASR_ENABLED=0
TENCENT_ASR_BASE_URL=https://asr.cloud.tencent.com/asr/flash/v1
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
# Legacy engine values are ignored by new tiered routes.
TENCENT_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_ASR_TIMEOUT_SEC=900
TENCENT_ASR_MAX_UPLOAD_MB=100
TENCENT_ASR_MAX_CONCURRENT=2
TENCENT_ASR_CHUNK_SECONDS=2400
TENCENT_ASR_CHUNK_OVERLAP_SEC=3
TENCENT_REALTIME_ASR_ENABLED=0
TENCENT_REALTIME_ASR_BASE_URL=wss://asr.cloud.tencent.com/asr/v2
TENCENT_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_REALTIME_ASR_MAX_CONCURRENT=16
TENCENT_REALTIME_ASR_CONNECT_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_ACQUIRE_TIMEOUT_SEC=10
TENCENT_REALTIME_ASR_FINAL_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_SIGNATURE_TTL_SEC=3600
TENCENT_REALTIME_ASR_FRAME_MS=200
TENCENT_REALTIME_ASR_QUEUE_SEC=6
TENCENT_REALTIME_ASR_BACKPRESSURE_TIMEOUT_SEC=15
# Standard tier: Tencent's standard 16 kHz Chinese engines. The configured monthly
# value is a usage reference only and does not cap standard-tier requests.
TENCENT_STANDARD_ASR_ENABLED=0
TENCENT_STANDARD_REALTIME_ASR_ENABLED=0
TENCENT_STANDARD_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_MONTHLY_LIMIT_SEC=18000
TENCENT_LEGACY_USAGE_TIER=precision
# Precision tier: large-model engines, billed by Tencent. It remains disabled until
# explicitly enabled and given a positive server-side recording-file budget cap.
TENCENT_PRECISION_ASR_ENABLED=0
TENCENT_PRECISION_REALTIME_ASR_ENABLED=0
TENCENT_PRECISION_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_MONTHLY_LIMIT_SEC=0
TENCENT_ASR_USAGE_ENABLED=1
TENCENT_ASR_USAGE_API_ENDPOINT=asr.tencentcloudapi.com
TENCENT_ASR_USAGE_REGION=ap-guangzhou
TENCENT_ASR_USAGE_TIMEZONE=Asia/Shanghai
TENCENT_ASR_USAGE_CACHE_SEC=300
TENCENT_ASR_USAGE_LEDGER_ENABLED=1
TENCENT_ASR_USAGE_LEDGER_PATH=./data/tencent-asr-usage.db
WEB_API_TOKEN=
WEB_API_USERNAME=admin
COMMUNITY_WRITE_ENABLED=true

ACCOUNT_TOKEN_SECRET=
ACCOUNT_ADMIN_USERNAME=admin
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_ADMIN_REQUEST_LIMIT=10000000
ACCOUNT_SESSION_TTL_SEC=2592000
ACCOUNT_FREE_REQUEST_LIMIT=10
ACCOUNT_FREE_PLAN_CODE=free
ACCOUNT_FREE_PLAN_NAME=Free
ACCOUNT_STT_TOKEN_TTL_SEC=43200
ACCOUNT_PROFILE_NAME_MAX_LENGTH=40
ACCOUNT_PROFILE_AVATAR_MAX_BYTES=262144
ACCOUNT_PROFILE_AVATAR_DATA_URL_MAX_LENGTH=524288

# Social login is discovered at runtime. Each URL must point to a deployed OAuth
# broker/start endpoint owned by this installation; platform secrets stay there.
ACCOUNT_AUTH_PROVIDERS_PATH=./config/auth-providers.json
ACCOUNT_AUTH_WECHAT_ENABLED=false
ACCOUNT_AUTH_WECHAT_LOGIN_URL=
ACCOUNT_AUTH_QQ_ENABLED=false
ACCOUNT_AUTH_QQ_LOGIN_URL=
ACCOUNT_AUTH_FEISHU_ENABLED=false
ACCOUNT_AUTH_FEISHU_LOGIN_URL=

# 0 removes the application-level cap; deployment proxy/model limits still apply.
AGENT_MAX_TEXT_CHARS=0
AGENT_MAX_REQUEST_JSON_BYTES=0

# faster-whisper supports true parallel requests. SenseVoice uses one shared serialized model.
STT_ENGINE=faster-whisper
STT_MODEL=small
STT_STREAM_MODEL=small
STT_DEVICE=auto
STT_MAX_CONCURRENT=2
STT_MAX_QUEUE=16
STT_MAX_STREAMS=16
STT_MAX_STREAMS_PER_OWNER=2
STT_MAX_UPLOAD_MB=1024
STT_LONG_AUDIO_CHUNK_THRESHOLD_SEC=2700
STT_LONG_AUDIO_CHUNK_SECONDS=1800
STT_LONG_AUDIO_CHUNK_OVERLAP_SEC=3
STT_CPU_THREADS=2
STT_STREAM_CPU_THREADS=2
STT_FINAL_RETRY_MIN_CHARS=8
STT_FINAL_BEAM_SIZE=5
STT_FINAL_BATCH_SIZE=1
STT_FINAL_CONDITION_ON_PREVIOUS_TEXT=1
STT_FINAL_INITIAL_PROMPT=以下是普通话会议记录，请使用规范中文标点。
STT_FINAL_RESTORE_PUNCTUATION=1
STT_FINAL_PUNCTUATION_PAUSE_SEC=0.8

# Revisable preview; the completed file still uses the final small/beam-5 decoder.
STREAM_UPDATE_INTERVAL_SEC=0.4
STREAM_MIN_AUDIO_SEC=2
STREAM_MAX_SNAPSHOT_SEC=8
STREAM_BUFFER_SEC=24
STREAM_OVERLAP_SEC=4
STREAM_STEP_SEC=4
STREAM_BEAM_SIZE=1
STREAM_FINAL_COMPAT_MIN_AUDIO_SEC=2
STREAM_STABLE_SIMILARITY=0.70
STREAM_STABLE_MIN_CHARS=4
STREAM_PROVISIONAL_MIN_CHARS=2
STREAM_MIN_CONFIDENCE=-0.90
STREAM_MAX_NO_SPEECH_PROB=0.35
STREAM_REJECT_FALLBACK_THRESHOLD=3

# Set to 1 only when the larger SenseVoice/PyTorch dependency set is needed.
INSTALL_SENSEVOICE=0
STT_GPU_COUNT=1
HF_ENDPOINT=https://hf-mirror.com
