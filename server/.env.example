# Network exposure. Keep the debug backend on localhost unless it is behind HTTPS/authentication.
STT_BIND_IP=0.0.0.0
STT_PORT=8888
BACKEND_BIND_IP=127.0.0.1
WEB_BACKEND_PORT=8090
# Built PWA directory. Defaults to a discovered release pwa-dist or source pwa/dist.
PWA_DIST_DIR=
# Optional public HTTPS URL shown in the debug console.
PUBLIC_STT_URL=

# Local Windows configuration. Ubuntu uses config/stt.env.example and generates tokens during installation.
# This is the server management token. Android account tokens may transcribe only;
# they cannot switch the shared STT model.
STT_API_TOKEN=
STT_PROXY_CONNECT_TIMEOUT_SEC=15
STT_PROXY_READ_TIMEOUT_SEC=1800
STT_AUDIO_ARCHIVE_ENABLED=0
STT_AUDIO_ARCHIVE_DIR=./data/audio-archive
STT_AUDIO_ARCHIVE_RETENTION_DAYS=30
STT_AUDIO_ARCHIVE_MAX_GB=10
STT_RECOVERY_DIR=./data/recovery-audio
# Deprecated generic Tencent switches. Keep disabled: tiered switches below are authoritative.
TENCENT_ASR_ENABLED=0
TENCENT_ASR_BASE_URL=https://asr.cloud.tencent.com/asr/flash/v1
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
# Legacy engine values are ignored by new tiered routes.
TENCENT_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_ASR_TIMEOUT_SEC=900
TENCENT_ASR_MAX_UPLOAD_MB=100
TENCENT_ASR_MAX_CONCURRENT=2
TENCENT_ASR_CHUNK_SECONDS=2400
TENCENT_ASR_CHUNK_OVERLAP_SEC=3
TENCENT_REALTIME_ASR_ENABLED=0
TENCENT_REALTIME_ASR_BASE_URL=wss://asr.cloud.tencent.com/asr/v2
TENCENT_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_REALTIME_ASR_MAX_CONCURRENT=16
TENCENT_REALTIME_ASR_CONNECT_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_ACQUIRE_TIMEOUT_SEC=10
TENCENT_REALTIME_ASR_FINAL_TIMEOUT_SEC=15
TENCENT_REALTIME_ASR_SIGNATURE_TTL_SEC=3600
TENCENT_REALTIME_ASR_FRAME_MS=200
TENCENT_REALTIME_ASR_QUEUE_SEC=6
TENCENT_REALTIME_ASR_BACKPRESSURE_TIMEOUT_SEC=15
# Standard tier: Tencent's standard 16 kHz Chinese engines. The configured monthly
# value is a usage reference only and does not cap standard-tier requests.
TENCENT_STANDARD_ASR_ENABLED=0
TENCENT_STANDARD_REALTIME_ASR_ENABLED=0
TENCENT_STANDARD_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE=16k_zh
TENCENT_STANDARD_REALTIME_ASR_ENGINE_TYPE_EN=16k_en
TENCENT_STANDARD_MONTHLY_LIMIT_SEC=18000
TENCENT_LEGACY_USAGE_TIER=precision
# Precision tier: large-model engines, billed by Tencent. It remains disabled until
# explicitly enabled and given a positive server-side recording-file budget cap.
TENCENT_PRECISION_ASR_ENABLED=0
TENCENT_PRECISION_REALTIME_ASR_ENABLED=0
TENCENT_PRECISION_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE=16k_zh_en
TENCENT_PRECISION_REALTIME_ASR_ENGINE_TYPE_EN=16k_zh_en
TENCENT_PRECISION_MONTHLY_LIMIT_SEC=0
TENCENT_ASR_USAGE_ENABLED=1
TENCENT_ASR_USAGE_API_ENDPOINT=asr.tencentcloudapi.com
TENCENT_ASR_USAGE_REGION=ap-guangzhou
TENCENT_ASR_USAGE_TIMEZONE=Asia/Shanghai
TENCENT_ASR_USAGE_CACHE_SEC=300
TENCENT_ASR_USAGE_LEDGER_ENABLED=1
TENCENT_ASR_USAGE_LEDGER_PATH=./data/tencent-asr-usage.db
WEB_API_TOKEN=
WEB_API_USERNAME=admin
COMMUNITY_WRITE_ENABLED=true
WEB_BACKEND_DB_PATH=./data/meeting_notes.db
ACCOUNT_DB_PATH=./data/accounts.db
ACCOUNT_MEDIA_DIR=/var/lib/meetingnotes-stt/backend/account-media
ACCOUNT_MEDIA_MAX_BYTES=12582912
# Production keeps this enabled. Personal GPU nodes may delegate billing to
# the upstream account service while continuing to validate signed STT tokens.
ACCOUNT_STT_BILLING_ENABLED=1
# Community tables use the account database by default because their foreign
# keys reference users. Set this only when the target database is provisioned
# with a synchronized users table.
COMMUNITY_DB_PATH=./data/accounts.db

ACCOUNT_TOKEN_SECRET=
ACCOUNT_ADMIN_USERNAME=admin
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_ADMIN_REQUEST_LIMIT=10000000
ACCOUNT_SESSION_TTL_SEC=2592000
ACCOUNT_FREE_REQUEST_LIMIT=10
ACCOUNT_FREE_PLAN_CODE=free
ACCOUNT_FREE_PLAN_NAME=免费账户
# Deprecated compatibility balances. Point billing is authoritative.
ACCOUNT_FREE_STT_MINUTES=0
ACCOUNT_FREE_AI_CREDITS=0
ACCOUNT_FREE_POINTS=1000
ACCOUNT_STT_POINTS_PER_MINUTE=10
ACCOUNT_AI_SUMMARY_POINTS=30
ACCOUNT_AI_CHAT_POINTS=10
ACCOUNT_STT_TOKEN_TTL_SEC=43200
ACCOUNT_PROFILE_NAME_MAX_LENGTH=40
ACCOUNT_PROFILE_AVATAR_MAX_BYTES=262144
ACCOUNT_PROFILE_AVATAR_DATA_URL_MAX_LENGTH=524288
ACCOUNT_REFERRAL_REWARD_POINTS=300
ACCOUNT_AUTH_CODE_DEBUG=false
ACCOUNT_AUTH_CODE_WEBHOOK_URL=
ACCOUNT_AUTH_CODE_WEBHOOK_TOKEN=
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=465
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_SMTP_FROM=
ACCOUNT_SMTP_USE_SSL=true

# Alipay APP payment. Keep credentials in an untracked environment file or the
# protected sandbox JSON; never put private keys in source or this example.
ALIPAY_ENABLED=false
ALIPAY_ENVIRONMENT=sandbox
ALIPAY_SANDBOX_CONFIG_PATH=
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_TIMEOUT_SEC=30

# Social login is brokered by this backend. Official public endpoints are loaded
# from config/auth-providers.defaults.json. Use an untracked auth-providers.json
# or environment variables to override them, and keep every credential in a
# secret manager. Callback URLs must be registered in each platform console.
ACCOUNT_AUTH_PROVIDERS_PATH=./config/auth-providers.json
ACCOUNT_AUTH_PUBLIC_BASE_URL=
ACCOUNT_AUTH_ANDROID_CALLBACK_URI=zhiwuben://auth/callback
ACCOUNT_AUTH_ALLOWED_REDIRECTS=
ACCOUNT_AUTH_HTTP_TIMEOUT_SEC=20
ACCOUNT_AUTH_WECHAT_ENABLED=false
ACCOUNT_AUTH_WECHAT_CLIENT_ID=
ACCOUNT_AUTH_WECHAT_CLIENT_SECRET=
ACCOUNT_AUTH_WECHAT_AUTHORIZE_ENDPOINT=
ACCOUNT_AUTH_WECHAT_TOKEN_ENDPOINT=
ACCOUNT_AUTH_WECHAT_USERINFO_ENDPOINT=
ACCOUNT_AUTH_WECHAT_SCOPES=
# Provider-specific protocol fields can also be supplied via environment variables.
# WeChat commonly uses: AUTHORIZE_CLIENT_ID_PARAM=appid,
# TOKEN_CLIENT_ID_PARAM=appid, TOKEN_CLIENT_SECRET_PARAM=secret,
# TOKEN_SUBJECT_FIELD=openid, USERINFO_TOKEN_PARAM=access_token,
# USERINFO_SUBJECT_PARAM=openid, AUTHORIZE_URL_SUFFIX="#wechat_redirect".
ACCOUNT_AUTH_WECHAT_AUTHORIZE_CLIENT_ID_PARAM=
ACCOUNT_AUTH_WECHAT_AUTHORIZE_URL_SUFFIX=
ACCOUNT_AUTH_WECHAT_TOKEN_METHOD=
ACCOUNT_AUTH_WECHAT_TOKEN_CLIENT_ID_PARAM=
ACCOUNT_AUTH_WECHAT_TOKEN_CLIENT_SECRET_PARAM=
ACCOUNT_AUTH_WECHAT_TOKEN_SUBJECT_FIELD=
ACCOUNT_AUTH_WECHAT_PKCE_ENABLED=
ACCOUNT_AUTH_WECHAT_USERINFO_TOKEN_PARAM=
ACCOUNT_AUTH_WECHAT_USERINFO_SUBJECT_PARAM=
ACCOUNT_AUTH_WECHAT_USERINFO_EXTRA_PARAMS=
ACCOUNT_AUTH_QQ_ENABLED=false
ACCOUNT_AUTH_QQ_CLIENT_ID=
ACCOUNT_AUTH_QQ_CLIENT_SECRET=
ACCOUNT_AUTH_QQ_AUTHORIZE_ENDPOINT=
ACCOUNT_AUTH_QQ_TOKEN_ENDPOINT=
ACCOUNT_AUTH_QQ_USERINFO_ENDPOINT=
ACCOUNT_AUTH_QQ_SCOPES=
ACCOUNT_AUTH_QQ_TOKEN_METHOD=
ACCOUNT_AUTH_QQ_TOKEN_RESPONSE_FORMAT=
ACCOUNT_AUTH_QQ_PKCE_ENABLED=
ACCOUNT_AUTH_QQ_SUBJECT_ENDPOINT=
ACCOUNT_AUTH_QQ_SUBJECT_RESPONSE_FORMAT=
ACCOUNT_AUTH_QQ_SUBJECT_TOKEN_PARAM=
ACCOUNT_AUTH_QQ_USERINFO_TOKEN_PARAM=
ACCOUNT_AUTH_QQ_USERINFO_SUBJECT_PARAM=
ACCOUNT_AUTH_QQ_USERINFO_CLIENT_ID_PARAM=
# Extra parameter maps use JSON objects, for example:
# ACCOUNT_AUTH_INSTAGRAM_USERINFO_EXTRA_PARAMS={"fields":"id,username"}
ACCOUNT_AUTH_FEISHU_ENABLED=false
ACCOUNT_AUTH_FEISHU_CLIENT_ID=
ACCOUNT_AUTH_FEISHU_CLIENT_SECRET=
ACCOUNT_AUTH_FEISHU_AUTHORIZE_ENDPOINT=
ACCOUNT_AUTH_FEISHU_TOKEN_ENDPOINT=
ACCOUNT_AUTH_FEISHU_USERINFO_ENDPOINT=
ACCOUNT_AUTH_FEISHU_SCOPES=
ACCOUNT_AUTH_TELEGRAM_ENABLED=false
ACCOUNT_AUTH_TELEGRAM_BOT_ID=
ACCOUNT_AUTH_TELEGRAM_BOT_TOKEN=
ACCOUNT_AUTH_WHATSAPP_ENABLED=false
ACCOUNT_AUTH_WHATSAPP_CLIENT_ID=
ACCOUNT_AUTH_WHATSAPP_CLIENT_SECRET=
ACCOUNT_AUTH_WHATSAPP_AUTHORIZE_ENDPOINT=
ACCOUNT_AUTH_WHATSAPP_TOKEN_ENDPOINT=
ACCOUNT_AUTH_WHATSAPP_USERINFO_ENDPOINT=
ACCOUNT_AUTH_WHATSAPP_SCOPES=
ACCOUNT_AUTH_INSTAGRAM_ENABLED=false
ACCOUNT_AUTH_INSTAGRAM_CLIENT_ID=
ACCOUNT_AUTH_INSTAGRAM_CLIENT_SECRET=
ACCOUNT_AUTH_INSTAGRAM_AUTHORIZE_ENDPOINT=
ACCOUNT_AUTH_INSTAGRAM_TOKEN_ENDPOINT=
ACCOUNT_AUTH_INSTAGRAM_USERINFO_ENDPOINT=
ACCOUNT_AUTH_INSTAGRAM_SCOPES=
ACCOUNT_AUTH_INSTAGRAM_USERINFO_EXTRA_PARAMS=

# 0 removes the application-level cap; deployment proxy/model limits still apply.
AGENT_MAX_TEXT_CHARS=0
AGENT_MAX_REQUEST_JSON_BYTES=0

# Faster-Whisper supports true parallel requests; keep this at 1 on constrained GPUs.
STT_ENGINE=faster-whisper
STT_MODEL=small
STT_STREAM_MODEL=small
STT_DEVICE=auto
STT_MAX_CONCURRENT=2
STT_MAX_QUEUE=16
STT_MAX_STREAMS=16
STT_MAX_STREAMS_PER_OWNER=2
STT_MAX_UPLOAD_MB=1024
STT_LONG_AUDIO_CHUNK_THRESHOLD_SEC=2700
STT_LONG_AUDIO_CHUNK_SECONDS=1800
STT_LONG_AUDIO_CHUNK_OVERLAP_SEC=3
STT_CPU_THREADS=2
STT_STREAM_CPU_THREADS=2
STT_FINAL_RETRY_MIN_CHARS=8
STT_FINAL_BEAM_SIZE=5
STT_FINAL_BATCH_SIZE=1
STT_FINAL_CONDITION_ON_PREVIOUS_TEXT=1
STT_FINAL_INITIAL_PROMPT=以下是普通话会议记录，请使用规范中文标点。
STT_FINAL_AUDIO_ENHANCEMENT=1
STT_FINAL_DENOISE_NOISE_FLOOR_DBFS=-48
STT_FINAL_DENOISE_MAX_SNR_DB=26
STT_FINAL_GAIN_SPEECH_LEVEL_DBFS=-28
STT_FINAL_DENOISE_REDUCTION_DB=8
STT_FINAL_AUDIO_ANALYSIS_MAX_WINDOWS=3000
STT_FINAL_CONTEXT_HINT_MAX_CHARS=240
STT_FINAL_RESTORE_PUNCTUATION=1
STT_FINAL_PUNCTUATION_PAUSE_SEC=0.8

# Revisable preview; the completed file still uses the final small/beam-5 decoder.
STREAM_UPDATE_INTERVAL_SEC=0.4
STREAM_MIN_AUDIO_SEC=2
STREAM_MAX_SNAPSHOT_SEC=8
STREAM_BUFFER_SEC=24
STREAM_OVERLAP_SEC=4
STREAM_STEP_SEC=4
STREAM_BEAM_SIZE=1
STREAM_FINAL_COMPAT_MIN_AUDIO_SEC=2
STREAM_STABLE_SIMILARITY=0.70
STREAM_STABLE_MIN_CHARS=4
STREAM_PROVISIONAL_MIN_CHARS=2
STREAM_MIN_CONFIDENCE=-0.90
STREAM_MAX_NO_SPEECH_PROB=0.35
STREAM_REJECT_FALLBACK_THRESHOLD=3

# Local STT uses the locked Faster-Whisper runtime.
STT_GPU_COUNT=1
HF_ENDPOINT=https://hf-mirror.com
